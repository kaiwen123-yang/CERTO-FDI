    },
    {
      "id": "PIPER-R2",
      "status": "PASS",
      "topic": "Motor cached feedback",
      "details": "get_motor_states returns parser cached object or None, updates hz from fps counter; polling is not fresh CAN RX. Timestamp comes from can frame backend."
    },
    {
      "id": "PIPER-R3",
      "status": "PASS",
      "topic": "Current-derived torque",
      "details": "decode_high_spd uses signed 16-bit current*1e-3 and torque=current*(k*b*c) from config, not independent torque sensing. MIT documentation gives PD+t_ff reference, not measured execution."
    },
    {
      "id": "PIPER-R4",
      "status": "CLARIFY_BEFORE_HARDWARE",
      "topic": "Aggregate timestamp",
      "details": "Getter selects joint_12 then joint_34 then joint_56 if present; aggregate timestamp is last selected present cache (joint_56 priority), not necessarily most recently received/max timestamp."
    },
    {
